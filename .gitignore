# External reference repository; keep it out of this project's Git history.
/open-design/

# Local code navigation/index data.
/.codegraph/

# JavaScript / TypeScript dependencies and build output.
/node_modules/
**/node_modules/
**/dist/
# electron-vite 的输出目录叫 out 而非 dist，与 dist 同为纯构建产物
**/out/
**/coverage/

# Native probe build output and generated artifacts.
**/.build/
/artifacts/

# Local environment noise.
.DS_Store
*.log
.env
.env.local

# Impeccable 的本机检测缓存（live/config.json 是项目配置，需入库）
/.impeccable/hook.cache.json

# TypeScript incremental build metadata.
*.tsbuildinfo
