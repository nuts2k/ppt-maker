{
  "name": "ppt-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build && pnpm build:vision && pnpm build:pdf",
    "build:vision": "mkdir -p native/macos-vision-ocr/.build/module-cache && xcrun swiftc -module-cache-path native/macos-vision-ocr/.build/module-cache native/macos-vision-ocr/Sources/main.swift -o native/macos-vision-ocr/.build/macos-vision-ocr",
    "build:pdf": "mkdir -p native/macos-pdf-render/.build/module-cache && xcrun swiftc -module-cache-path native/macos-pdf-render/.build/module-cache native/macos-pdf-render/Sources/main.swift -o native/macos-pdf-render/.build/macos-pdf-render",
    "fixture:foundation": "mkdir -p fixtures/foundation native/macos-vision-ocr/.build/module-cache && xcrun swift -module-cache-path native/macos-vision-ocr/.build/module-cache native/macos-vision-ocr/Sources/generate-fixture.swift fixtures/foundation/mixed-text.png && xcrun swift -module-cache-path native/macos-vision-ocr/.build/module-cache native/macos-vision-ocr/Sources/generate-fixture.swift fixtures/foundation/mixed-text.jpg",
    "fixture:pdf": "mkdir -p fixtures/pdf-extraction native/macos-pdf-render/.build/module-cache && xcrun swift -module-cache-path native/macos-pdf-render/.build/module-cache native/macos-pdf-render/Sources/generate-test-pdf.swift fixtures/pdf-extraction",
    "fixture:single-slide": "mkdir -p fixtures/single-slide native/macos-vision-ocr/.build/module-cache && xcrun swift -module-cache-path native/macos-vision-ocr/.build/module-cache native/macos-vision-ocr/Sources/generate-complex-fixture.swift fixtures/single-slide/complex-page.png",
    "format": "biome check --write apps/*/src apps/*/test packages/*/src packages/*/test",
    "format:check": "biome check apps/*/src apps/*/test packages/*/src packages/*/test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "desktop": "pnpm --filter @ppt-maker/desktop dev",
    "ppt-maker": "node apps/cli/dist/index.js",
    "ppt-maker:dev": "tsx --conditions=development apps/cli/src/index.ts",
    "probe:ocr": "node apps/cli/dist/index.js probe ocr",
    "probe:pptx": "node apps/cli/dist/index.js probe pptx"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
